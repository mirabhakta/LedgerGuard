# Copy to .env (gitignored) and export before running the eval, e.g. `set -a; source .env; set +a`.

# Conventional LLM baseline (any OpenAI-compatible chat-completions endpoint)
LLM_BASELINE_BASE_URL=https://api.openai.com/v1
LLM_BASELINE_MODEL=
LLM_BASELINE_API_KEY=
LLM_BASELINE_TIMEOUT_S=20

# Optional: location of the sponsor dataset (defaults to ./data)
# LEDGERGUARD_DATA_DIR=
