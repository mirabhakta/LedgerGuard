# Copy this file to .env and fill in local secrets. Never commit real API keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TypeSafe System One / Jev. Model discovery is automatic when TYPESAFE_MODEL is empty.
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional override for testing a compatible endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenJev is a separate local server and does not require an API key by default.
OPENJEV_BASE_URL=http://127.0.0.1:8771
OPENJEV_MODEL=Qwen/Qwen3-0.6B
# OPENJEV_API_KEY=

# Optional local FastAPI settings.
# LEDGERGUARD_DB_PATH=/tmp/ledgerguard.sqlite3
# LEDGERGUARD_CORS_ORIGINS=http://localhost:5173
